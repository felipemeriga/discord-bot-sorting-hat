# Discord Bot Token (get from https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here

# Guild (Server) ID
GUILD_ID=your_guild_id

# Storage Configuration
# Options: local (default), s3
STORAGE_TYPE=local

# S3 Storage Configuration (only required when STORAGE_TYPE=s3)
# S3_BUCKET_NAME=your-bucket-name
# S3_STORAGE_KEY=sorted_users.json  # Optional, defaults to sorted_users.json
# AWS_REGION=us-east-1  # Optional, AWS SDK will use default credentials and region
